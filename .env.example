# ── Runtime (all optional for local dev — the app runs fully offline) ─────────
# Canonical origin used in SEO canonical/OG/Twitter URLs, sitemap, robots and RSS.
# Inlined at BUILD time — set it before `npm run build`. No trailing slash.
# Defaults to https://www.lostmodesty.org when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign session + analytics cookies. A dev fallback is used when
# unset; REQUIRED in production (see DEPLOYMENT_GUIDE.md §3).
# SESSION_SECRET=change-me-to-a-long-random-string

# SQLite database file location (defaults to data/lostmodesty.db).
# DATABASE_PATH=data/lostmodesty.db

# ── Script-only vars (not read by the app) ────────────────────────────────────
# build-redirect-map.mjs — URL inventory CSV (sample ships in data/):
# INVENTORY=data/url-inventory.sample.csv
# parity-check.mjs — directory of saved OLD/NEW HTML snapshots:
# SNAP_DIR=data/snapshots
# shadow-diff.mjs — live origins to diff (access-gated):
# NEW_ORIGIN=
# OLD_ORIGIN=
# PATHS=
# capture-baseline.mjs / cwv-baseline.mjs — live pages to baseline (access-gated):
# LIVE_INDEX=
# LIVE_ARTICLE=
